+  { path = "contactclean/csvio.py", language = "python", exceptions = ["OSError", "UnicodeDecodeError", "csv.Error"], reason = "File and CSV I/O on the user's input; each failure becomes UnreadableInputError (exit 2 per SPEC.md)" },
+  { path = "contactclean/cli.py", language = "python", exceptions = ["contactclean.csvio.UnreadableInputError", "contactclean.clean.InputFormatError"], reason = "Command-line entry point: an input that cannot be read is reported on stderr with exit 2 per SPEC.md" },
+]
 
 [tool.shockharness.rules.defaults]
