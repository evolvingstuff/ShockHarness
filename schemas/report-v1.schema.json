{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evolvingstuff/ShockHarness/schemas/report-v1.schema.json",
  "title": "ShockHarness report, schema_version 1",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "analysis_status",
    "config_digest",
    "effective_profile",
    "config",
    "coverage",
    "files",
    "findings",
    "metrics",
    "gate",
    "execution_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "tool_version": {
      "type": "string"
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ]
    },
    "config_digest": {
      "type": "string"
    },
    "effective_profile": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "required": [
        "source",
        "notes",
        "deviations"
      ],
      "properties": {
        "source": {
          "type": "object",
          "required": [
            "tier",
            "path"
          ],
          "properties": {
            "tier": {
              "type": "string",
              "enum": [
                "cli",
                "dedicated",
                "pyproject",
                "bundled"
              ]
            },
            "path": {
              "type": "string"
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "type": [
            "object",
            "null"
          ],
          "description": "H2 part 2, additive: the --policy file, null without one. keys lists every dotted key it sets; digest is the SHA-256 of its canonical JSON.",
          "required": [
            "path",
            "digest",
            "keys"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "policy_attempts": {
          "type": "array",
          "description": "H2 part 2, additive: every repository key that would have loosened a key the --policy file sets. The policy's value applies, and each attempt is reported as VERIFY003.",
          "items": {
            "type": "object",
            "required": [
              "key",
              "policy_value",
              "attempted_value",
              "reasons"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "policy_value": {},
              "attempted_value": {},
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "host_python",
        "languages",
        "rules_implemented",
        "rules_not_implemented",
        "rules_disabled_globally",
        "files_analyzed",
        "files_failed",
        "limitations",
        "cache"
      ],
      "properties": {
        "host_python": {
          "type": "string"
        },
        "languages": {
          "type": "object"
        },
        "rules_implemented": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules_not_implemented": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules_disabled_globally": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_analyzed": {
          "type": "integer"
        },
        "files_failed": {
          "type": "integer"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_sources_policy": {
          "type": "string",
          "enum": [
            "fail",
            "warn",
            "ignore"
          ]
        },
        "unsupported_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "cache": {
          "type": "object",
          "description": "The content-hash cache of per-file results (0.3.0). The one coverage block that differs between a cold and a warm run over the same tree; determinism comparisons drop it.",
          "required": [
            "status",
            "directory",
            "reason",
            "hits",
            "misses",
            "invalidated",
            "errors",
            "problems"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled",
                "bypassed"
              ]
            },
            "directory": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "hits": {
              "type": "integer"
            },
            "misses": {
              "type": "integer"
            },
            "invalidated": {
              "type": "integer"
            },
            "errors": {
              "type": "integer"
            },
            "problems": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "roles": {
          "type": "object",
          "description": "H1, additive: analyzed and failed files per role; every role is listed.",
          "required": [
            "generated",
            "vendor",
            "config",
            "test",
            "docs",
            "production"
          ],
          "properties": {
            "generated": {
              "type": "integer"
            },
            "vendor": {
              "type": "integer"
            },
            "config": {
              "type": "integer"
            },
            "test": {
              "type": "integer"
            },
            "docs": {
              "type": "integer"
            },
            "production": {
              "type": "integer"
            }
          }
        },
        "rules_needing_base_revision": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "H2, additive: implemented rules that compare a head revision with a base revision (VERIFY001 to VERIFY004); they produce findings only under diff or gate --base/--head."
        },
        "verification": {
          "type": "object",
          "description": "H2, additive: the VERIFY rules' state for this run. 'not_applicable' in a plain check (they compare two revisions), 'analyzed' in a revision diff or gate, 'disabled' when rules.verification.enabled is false. In a diff the counts describe the comparison with the base revision.",
          "required": [
            "status",
            "rules"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "not_applicable",
                "analyzed",
                "disabled"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            },
            "base_commit": {
              "type": "string"
            },
            "files_compared": {
              "type": "integer"
            },
            "files_new": {
              "type": "integer"
            },
            "renamed": {
              "type": "integer"
            },
            "base_unanalyzable": {
              "type": "integer"
            },
            "rename_detection": {
              "type": "string",
              "enum": [
                "available",
                "unavailable"
              ]
            },
            "rename_detection_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "warning",
                "error",
                "review"
              ]
            },
            "allowed_skip_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "report_narrow_suppressions": {
              "type": "boolean"
            },
            "policy": {
              "type": "object",
              "description": "H2 part 2, additive (revision diff only): what VERIFY003 compared. configuration is compared, unknown (a revision's committed configuration could not be read) or disabled; workflows are checked only when the analysis root is the repository's top level; read_errors maps a path to why it could not be read.",
              "required": [
                "configuration",
                "workflows_checked",
                "files_compared",
                "baselines",
                "read_errors"
              ],
              "properties": {
                "configuration": {
                  "type": "string",
                  "enum": [
                    "compared",
                    "unknown",
                    "disabled"
                  ]
                },
                "workflows_checked": {
                  "type": "boolean"
                },
                "workflows_note": {
                  "type": "string"
                },
                "files_compared": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "baselines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "read_errors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "policy_attempts": {
              "type": "integer",
              "description": "H2 part 2, additive (revision diff only): the number of --policy attempts reported as VERIFY003."
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "status",
          "line_count",
          "rules_applied",
          "rules_disabled",
          "finding_count"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": [
              "python",
              "javascript",
              "unsupported"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "analyzed",
              "parse_error",
              "decode_error",
              "read_error",
              "unsupported_source"
            ]
          },
          "line_count": {
            "type": "integer"
          },
          "rules_applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules_disabled": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule_id",
                "reason",
                "origin"
              ],
              "properties": {
                "rule_id": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                }
              }
            }
          },
          "finding_count": {
            "type": "integer"
          },
          "role": {
            "type": "string",
            "enum": [
              "generated",
              "vendor",
              "config",
              "test",
              "docs",
              "production"
            ],
            "description": "H1, additive: the file's role, the first of generated, vendor, config, test, docs whose file_roles globs match its path, else production."
          },
          "role_pattern": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "H1, additive: the file_roles glob that decided the role as written; null for production."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "rule_version",
          "severity",
          "path",
          "span",
          "message",
          "evidence",
          "confidence",
          "remediation",
          "safe_autofix",
          "scope",
          "suppression",
          "fingerprint",
          "baseline"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "rule_version": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "review",
              "note"
            ]
          },
          "path": {
            "type": "string"
          },
          "span": {
            "type": "object",
            "required": [
              "line",
              "column",
              "end_line",
              "end_column"
            ],
            "properties": {
              "line": {
                "type": "integer"
              },
              "column": {
                "type": "integer"
              },
              "end_line": {
                "type": "integer"
              },
              "end_column": {
                "type": "integer"
              }
            }
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "exact",
              "approximate",
              "unresolved"
            ]
          },
          "remediation": {
            "type": "string"
          },
          "safe_autofix": {
            "type": "boolean"
          },
          "fingerprint": {
            "type": "string"
          },
          "baseline": {
            "enum": [
              "matched",
              "ignored",
              null
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "violation",
              "unknown"
            ],
            "description": "H1, additive: 'violation' when the rule established the property and it does not hold; 'unknown' when the rule could not establish it (an unresolved exception identity, an opaque handler, a receiver whose type is not established). Orthogonal to severity; rules.<family>.fail_on_unknown (complexity.fail_on_unknown) decides whether an unknown finding gates."
          },
          "category": {
            "type": "string",
            "enum": [
              "policy_integrity",
              "contract_integrity",
              "structural"
            ],
            "description": "H2, additive: the category of the rule's family. policy_integrity (VERIFY*) means the change weakened its own verification; contract_integrity covers MAGIC, EXC, DEF and SUPP; structural covers CPLX. A gating policy_integrity finding exits 1 like any hard violation (spec 21.1 decision 2)."
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "complexity",
        "graph",
        "history"
      ],
      "properties": {
        "history": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "granularity",
            "files",
            "cochange",
            "hotspots",
            "hotspots_reason",
            "hotspots_formula"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "disabled",
                "not_collected"
              ]
            },
            "granularity": {
              "type": "string",
              "enum": [
                "file"
              ]
            },
            "files": {
              "type": "object"
            },
            "cochange": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "paths",
                  "support",
                  "confidence"
                ],
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "support": {
                    "type": "integer"
                  },
                  "confidence": {
                    "type": "object",
                    "required": [
                      "first_to_second",
                      "second_to_first"
                    ]
                  }
                }
              }
            },
            "hotspots": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "churn",
                      "cognitive_total",
                      "normalized_complexity",
                      "score"
                    ]
                  }
                }
              ]
            },
            "hotspots_reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "hotspots_formula": {
              "type": "string"
            }
          }
        },
        "complexity": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "conventions",
            "thresholds",
            "functions",
            "files"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "disabled"
              ]
            },
            "conventions": {
              "type": "object",
              "required": [
                "cyclomatic",
                "cognitive",
                "nesting",
                "npath",
                "size",
                "cyclomatic_counts_boolean_operators",
                "optional_chaining_counted",
                "nested_units",
                "cognitive_note"
              ]
            },
            "thresholds": {
              "type": "object",
              "required": [
                "cyclomatic_warn",
                "cognitive_warn",
                "max_nesting_warn",
                "npath_warn",
                "fan_out_warn"
              ]
            },
            "functions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "path",
                  "name",
                  "kind",
                  "async",
                  "generator",
                  "span",
                  "size",
                  "cyclomatic",
                  "cognitive",
                  "nesting",
                  "npath"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "module",
                      "class",
                      "function",
                      "method",
                      "lambda",
                      "arrow"
                    ]
                  },
                  "span": {
                    "type": "object",
                    "required": [
                      "line",
                      "column",
                      "end_line",
                      "end_column"
                    ]
                  },
                  "size": {
                    "type": "object",
                    "required": [
                      "logical_lines",
                      "parameters",
                      "statements"
                    ]
                  },
                  "cyclomatic": {
                    "type": "integer"
                  },
                  "cognitive": {
                    "type": "integer"
                  },
                  "nesting": {
                    "type": "integer"
                  },
                  "npath": {
                    "type": "object",
                    "required": [
                      "value",
                      "saturated",
                      "cap",
                      "text"
                    ],
                    "properties": {
                      "value": {
                        "type": "integer"
                      },
                      "saturated": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            },
            "files": {
              "type": "object"
            },
            "regressions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule_id",
                  "key",
                  "path",
                  "name",
                  "span",
                  "metric",
                  "base",
                  "head",
                  "threshold",
                  "convention",
                  "new_unit"
                ]
              }
            },
            "regression_policy": {
              "type": "string",
              "enum": [
                "warn",
                "fail",
                "ignore"
              ]
            }
          }
        },
        "graph": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "confidence",
            "summary",
            "modules",
            "module_edges",
            "units",
            "edges",
            "cycles",
            "shared_mutable_state",
            "abstraction_displacement"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "disabled"
              ]
            },
            "confidence": {
              "type": "object",
              "required": [
                "resolved",
                "probable",
                "unresolved"
              ]
            },
            "summary": {
              "type": "object",
              "required": [
                "modules",
                "units",
                "call_edges",
                "call_sites",
                "module_edges",
                "cycles",
                "shared_mutable_state"
              ],
              "properties": {
                "call_edges": {
                  "type": "object",
                  "required": [
                    "resolved",
                    "probable",
                    "unresolved"
                  ]
                },
                "call_sites": {
                  "type": "object",
                  "required": [
                    "resolved",
                    "probable",
                    "unresolved"
                  ]
                },
                "module_edges": {
                  "type": "object",
                  "required": [
                    "resolved",
                    "external",
                    "unresolved"
                  ]
                }
              }
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "fan_in",
                  "fan_out",
                  "cycle"
                ]
              }
            },
            "module_edges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "specifier",
                  "level",
                  "kind",
                  "imported",
                  "to",
                  "confidence",
                  "span",
                  "reason"
                ],
                "properties": {
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "external",
                      "unresolved"
                    ]
                  }
                }
              }
            },
            "units": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "path",
                  "name",
                  "fan_in",
                  "fan_out",
                  "fan_out_external",
                  "fan_out_total",
                  "calls"
                ]
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "confidence",
                  "kind",
                  "calls",
                  "span",
                  "reason"
                ],
                "properties": {
                  "to": {
                    "type": "object",
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "unit",
                          "external",
                          "builtin",
                          "unresolved"
                        ]
                      }
                    }
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "probable",
                      "unresolved"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "call",
                      "argument",
                      "new"
                    ]
                  },
                  "span": {
                    "type": "object",
                    "required": [
                      "line",
                      "column",
                      "end_line",
                      "end_column"
                    ]
                  }
                }
              }
            },
            "cycles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "modules",
                  "confidence",
                  "edges"
                ]
              }
            },
            "shared_mutable_state": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "name",
                  "span",
                  "writers",
                  "confidence",
                  "note"
                ]
              }
            },
            "abstraction_displacement": {
              "type": "object",
              "required": [
                "enabled",
                "experimental",
                "status",
                "reason",
                "findings"
              ],
              "properties": {
                "experimental": {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "not_applicable",
                    "disabled",
                    "unavailable",
                    "available"
                  ]
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "path",
                      "name",
                      "span",
                      "local",
                      "reachable_burden",
                      "confidence",
                      "experimental"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "exit_code",
        "hard_violations",
        "suppressed",
        "warnings",
        "review",
        "analysis_failures",
        "baselined",
        "new_hard_violations",
        "baseline",
        "reasons",
        "advisory",
        "complexity_regressions"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "error"
          ]
        },
        "advisory": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer",
          "enum": [
            0,
            1,
            3
          ]
        },
        "hard_violations": {
          "type": "integer"
        },
        "suppressed": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        },
        "review": {
          "type": "integer"
        },
        "analysis_failures": {
          "type": "integer"
        },
        "baselined": {
          "type": "integer"
        },
        "new_hard_violations": {
          "type": "integer"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "source",
                "origin",
                "mode",
                "applied",
                "matched",
                "stale",
                "tool_version",
                "config_digest_matches",
                "notes"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "file",
                    "base_revision"
                  ]
                },
                "origin": {
                  "type": "string"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "fail",
                    "ignore"
                  ]
                },
                "applied": {
                  "type": "boolean"
                },
                "matched": {
                  "type": "integer"
                },
                "stale": {
                  "type": "array"
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complexity_regressions": {
          "type": "integer"
        },
        "unknown": {
          "type": "integer",
          "description": "H1, additive: findings with status unknown that are neither suppressed nor ignored by a baseline, whether or not they gate."
        },
        "unknown_gating_families": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "magic_numbers",
              "exceptions",
              "defaults",
              "complexity"
            ]
          },
          "description": "H1, additive: the rule families whose fail_on_unknown is true; their unknown findings gate by severity, the others are reported only."
        }
      }
    },
    "execution_summary": {
      "type": "object",
      "required": [
        "files",
        "findings",
        "findings_by_severity",
        "suppressed",
        "baselined"
      ]
    },
    "summary": {
      "type": "object",
      "description": "First-contact overview (0.2.0, additive): the counts behind `check --summary`. Totals equal execution_summary. Elapsed time appears only in text output, so the JSON report stays byte-identical across runs.",
      "required": [
        "files",
        "files_analyzed",
        "parse_failures",
        "findings",
        "suppressed",
        "by_severity",
        "by_rule",
        "by_directory",
        "by_rule_and_directory",
        "policy_families",
        "top_files_limit",
        "top_files",
        "complexity"
      ],
      "properties": {
        "files": {
          "type": "integer"
        },
        "files_analyzed": {
          "type": "integer"
        },
        "parse_failures": {
          "type": "integer"
        },
        "findings": {
          "type": "integer"
        },
        "suppressed": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_rule": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_directory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_rule_and_directory": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        },
        "policy_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "top_files_limit": {
          "type": "integer"
        },
        "top_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "policy_findings"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "policy_findings": {
                "type": "integer"
              }
            }
          }
        },
        "complexity": {
          "type": "object",
          "required": [
            "status",
            "units",
            "units_over",
            "npath_saturated_units",
            "cycles",
            "units_over_fan_out_warn",
            "thresholds"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "disabled"
              ]
            },
            "units": {
              "type": "integer"
            },
            "units_over": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "npath_saturated_units": {
              "type": "integer"
            },
            "cycles": {
              "type": "integer"
            },
            "units_over_fan_out_warn": {
              "type": "integer"
            },
            "thresholds": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        },
        "by_status": {
          "type": "object",
          "description": "H1, additive: findings per status; both statuses are listed.",
          "required": [
            "violation",
            "unknown"
          ],
          "properties": {
            "violation": {
              "type": "integer"
            },
            "unknown": {
              "type": "integer"
            }
          }
        },
        "by_role": {
          "type": "object",
          "description": "H1, additive: findings per role of the file they are in; every role is listed.",
          "required": [
            "generated",
            "vendor",
            "config",
            "test",
            "docs",
            "production"
          ],
          "properties": {
            "generated": {
              "type": "integer"
            },
            "vendor": {
              "type": "integer"
            },
            "config": {
              "type": "integer"
            },
            "test": {
              "type": "integer"
            },
            "docs": {
              "type": "integer"
            },
            "production": {
              "type": "integer"
            }
          }
        },
        "by_category": {
          "type": "object",
          "description": "H2, additive: findings per category; every category is listed.",
          "required": [
            "policy_integrity",
            "contract_integrity",
            "structural"
          ],
          "properties": {
            "policy_integrity": {
              "type": "integer"
            },
            "contract_integrity": {
              "type": "integer"
            },
            "structural": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
