{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evolvingstuff/ShockHarness/schemas/diff-v1.schema.json",
  "title": "ShockHarness revision diff report, schema_version 1",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "report_kind",
    "analysis_status",
    "config_digest",
    "effective_profile",
    "config",
    "coverage",
    "base",
    "head",
    "findings",
    "summary",
    "metrics",
    "gate"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "tool_version": {
      "type": "string"
    },
    "report_kind": {
      "type": "string",
      "enum": [
        "diff"
      ]
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ]
    },
    "config_digest": {
      "type": "string"
    },
    "effective_profile": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "description": "The effective configuration's source, notes and deviations, as in the check report. H2 part 2, additive: policy and policy_attempts.",
      "properties": {
        "policy": {
          "type": [
            "object",
            "null"
          ],
          "description": "H2 part 2, additive: the --policy file, null without one. keys lists every dotted key it sets; digest is the SHA-256 of its canonical JSON.",
          "required": [
            "path",
            "digest",
            "keys"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "policy_attempts": {
          "type": "array",
          "description": "H2 part 2, additive: every repository key that would have loosened a key the --policy file sets. The policy's value applies, and each attempt is reported as VERIFY003.",
          "items": {
            "type": "object",
            "required": [
              "key",
              "policy_value",
              "attempted_value",
              "reasons"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "policy_value": {},
              "attempted_value": {},
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "base": {
      "$ref": "#/$defs/revision"
    },
    "head": {
      "$ref": "#/$defs/revision"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "rule_id",
          "severity",
          "path",
          "span",
          "message",
          "fingerprint",
          "baseline",
          "suppression"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "new",
              "fixed",
              "unchanged"
            ]
          },
          "fingerprint": {
            "type": "string"
          },
          "finding_status": {
            "type": "string",
            "enum": [
              "violation",
              "unknown"
            ],
            "description": "H1, additive: the finding's own status (violation or unknown). A diff finding's 'status' keeps its 0.1.0 meaning (new, fixed, unchanged)."
          },
          "category": {
            "type": "string",
            "enum": [
              "policy_integrity",
              "contract_integrity",
              "structural"
            ],
            "description": "H2, additive: the category of the rule's family. policy_integrity (VERIFY*) means the change weakened its own verification; contract_integrity covers MAGIC, EXC, DEF and SUPP; structural covers CPLX. A gating policy_integrity finding exits 1 like any hard violation (spec 21.1 decision 2)."
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "new",
        "fixed",
        "unchanged",
        "new_hard_violations",
        "fixed_hard_violations",
        "unchanged_hard_violations",
        "complexity_regressions"
      ],
      "properties": {
        "new_policy_integrity": {
          "type": "integer",
          "description": "H2, additive: new findings whose category is policy_integrity (VERIFY001, VERIFY002, VERIFY004)."
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "complexity",
        "graph",
        "history"
      ],
      "properties": {
        "complexity": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "conventions",
            "thresholds",
            "functions",
            "files"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "disabled"
              ]
            },
            "conventions": {
              "type": "object",
              "required": [
                "cyclomatic",
                "cognitive",
                "nesting",
                "npath",
                "size",
                "cyclomatic_counts_boolean_operators",
                "optional_chaining_counted",
                "nested_units",
                "cognitive_note"
              ]
            },
            "thresholds": {
              "type": "object",
              "required": [
                "cyclomatic_warn",
                "cognitive_warn",
                "max_nesting_warn",
                "npath_warn",
                "fan_out_warn"
              ]
            },
            "functions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "path",
                  "name",
                  "kind",
                  "async",
                  "generator",
                  "span",
                  "size",
                  "cyclomatic",
                  "cognitive",
                  "nesting",
                  "npath"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "module",
                      "class",
                      "function",
                      "method",
                      "lambda",
                      "arrow"
                    ]
                  },
                  "span": {
                    "type": "object",
                    "required": [
                      "line",
                      "column",
                      "end_line",
                      "end_column"
                    ]
                  },
                  "size": {
                    "type": "object",
                    "required": [
                      "logical_lines",
                      "parameters",
                      "statements"
                    ]
                  },
                  "cyclomatic": {
                    "type": "integer"
                  },
                  "cognitive": {
                    "type": "integer"
                  },
                  "nesting": {
                    "type": "integer"
                  },
                  "npath": {
                    "type": "object",
                    "required": [
                      "value",
                      "saturated",
                      "cap",
                      "text"
                    ],
                    "properties": {
                      "value": {
                        "type": "integer"
                      },
                      "saturated": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            },
            "files": {
              "type": "object"
            },
            "regressions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule_id",
                  "key",
                  "path",
                  "name",
                  "span",
                  "metric",
                  "base",
                  "head",
                  "threshold",
                  "convention",
                  "new_unit"
                ]
              }
            },
            "regression_policy": {
              "type": "string",
              "enum": [
                "warn",
                "fail",
                "ignore"
              ]
            }
          }
        },
        "graph": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "confidence",
            "summary",
            "modules",
            "module_edges",
            "units",
            "edges",
            "cycles",
            "shared_mutable_state",
            "abstraction_displacement"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "disabled"
              ]
            },
            "confidence": {
              "type": "object",
              "required": [
                "resolved",
                "probable",
                "unresolved"
              ]
            },
            "summary": {
              "type": "object",
              "required": [
                "modules",
                "units",
                "call_edges",
                "call_sites",
                "module_edges",
                "cycles",
                "shared_mutable_state"
              ],
              "properties": {
                "call_edges": {
                  "type": "object",
                  "required": [
                    "resolved",
                    "probable",
                    "unresolved"
                  ]
                },
                "call_sites": {
                  "type": "object",
                  "required": [
                    "resolved",
                    "probable",
                    "unresolved"
                  ]
                },
                "module_edges": {
                  "type": "object",
                  "required": [
                    "resolved",
                    "external",
                    "unresolved"
                  ]
                }
              }
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "fan_in",
                  "fan_out",
                  "cycle"
                ]
              }
            },
            "module_edges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "specifier",
                  "level",
                  "kind",
                  "imported",
                  "to",
                  "confidence",
                  "span",
                  "reason"
                ],
                "properties": {
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "external",
                      "unresolved"
                    ]
                  }
                }
              }
            },
            "units": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "path",
                  "name",
                  "fan_in",
                  "fan_out",
                  "fan_out_external",
                  "fan_out_total",
                  "calls"
                ]
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "confidence",
                  "kind",
                  "calls",
                  "span",
                  "reason"
                ],
                "properties": {
                  "to": {
                    "type": "object",
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "unit",
                          "external",
                          "builtin",
                          "unresolved"
                        ]
                      }
                    }
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "probable",
                      "unresolved"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "call",
                      "argument",
                      "new"
                    ]
                  },
                  "span": {
                    "type": "object",
                    "required": [
                      "line",
                      "column",
                      "end_line",
                      "end_column"
                    ]
                  }
                }
              }
            },
            "cycles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "modules",
                  "confidence",
                  "edges"
                ]
              }
            },
            "shared_mutable_state": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "name",
                  "span",
                  "writers",
                  "confidence",
                  "note"
                ]
              }
            },
            "abstraction_displacement": {
              "type": "object",
              "required": [
                "enabled",
                "experimental",
                "status",
                "reason",
                "findings"
              ],
              "properties": {
                "experimental": {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "not_applicable",
                    "disabled",
                    "unavailable",
                    "available"
                  ]
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "path",
                      "name",
                      "span",
                      "local",
                      "reachable_burden",
                      "confidence",
                      "experimental"
                    ]
                  }
                }
              }
            }
          }
        },
        "history": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "granularity",
            "files",
            "cochange",
            "hotspots",
            "hotspots_reason",
            "hotspots_formula"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "disabled",
                "not_collected"
              ]
            },
            "granularity": {
              "type": "string",
              "enum": [
                "file"
              ]
            },
            "files": {
              "type": "object"
            },
            "cochange": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "paths",
                  "support",
                  "confidence"
                ],
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "support": {
                    "type": "integer"
                  },
                  "confidence": {
                    "type": "object",
                    "required": [
                      "first_to_second",
                      "second_to_first"
                    ]
                  }
                }
              }
            },
            "hotspots": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "churn",
                      "cognitive_total",
                      "normalized_complexity",
                      "score"
                    ]
                  }
                }
              ]
            },
            "hotspots_reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "hotspots_formula": {
              "type": "string"
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "exit_code",
        "new_hard_violations",
        "baseline",
        "reasons",
        "advisory",
        "complexity_regressions"
      ],
      "properties": {
        "advisory": {
          "type": "boolean"
        },
        "complexity_regressions": {
          "type": "integer"
        },
        "unknown": {
          "type": "integer",
          "description": "H1, additive: findings with status unknown that are neither suppressed nor ignored by a baseline, whether or not they gate."
        },
        "unknown_gating_families": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "magic_numbers",
              "exceptions",
              "defaults",
              "complexity"
            ]
          },
          "description": "H1, additive: the rule families whose fail_on_unknown is true; their unknown findings gate by severity, the others are reported only."
        }
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "required": [
        "ref",
        "commit",
        "analysis_status",
        "files_analyzed",
        "files_failed",
        "files",
        "findings",
        "suppressed"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "files": {
          "type": "array"
        }
      }
    }
  }
}
